{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: FraudGuard AI Dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/dashboard/app.py",
        "--server.address",
        "localhost"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Kafka: Real-Time Streaming Demo",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_kafka_streaming.py",
      "args": [
        "--events",
        "30",
        "--rate",
        "10",
        "--mode",
        "simulated"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Pipeline: Train Models & Generate Artifacts (main.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
